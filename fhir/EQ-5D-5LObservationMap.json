{
  "resourceType": "StructureMap",
  "id": "EQ5D5L-to-OMOP-Observation",
  "url": "http://example.org/StructureMap/EQ5D5L-to-OMOP-Observation",
  "version": "1.0.0",
  "name": "EQ5D5L to OMOP Observation",
  "status": "active",
  "date": "2026-04-16",
  "publisher": "D4L",
  "description": "Maps the five categorical EQ-5D-5L dimension items (mobility, self-care, usual-activities, pain-discomfort, anxiety-depression) from a QuestionnaireResponse to OMOP Observation rows.",
  "structure": [
    {
      "url": "http://hl7.org/fhir/StructureDefinition/QuestionnaireResponse",
      "mode": "source"
    },
    {
      "url": "http://hl7.org/fhir/uv/omop/StructureDefinition/Observation",
      "mode": "target"
    }
  ],
  "group": [
    {
      "name": "EQ5D5L_to_Observation",
      "typeMode": "none",
      "input": [
        {
          "name": "src",
          "type": "QuestionnaireResponse",
          "mode": "source"
        },
        {
          "name": "tgt",
          "type": "Observation",
          "mode": "target"
        }
      ],
      "rule": [
        {
          "name": "captureQrId",
          "source": [
            {
              "context": "src",
              "element": "id",
              "variable": "qrId"
            }
          ],
          "rule": [
            {
              "name": "mobility",
              "source": [
                {
                  "context": "src",
                  "element": "item",
                  "variable": "qitem",
                  "condition": "linkId = 'mobility'"
                }
              ],
              "target": [
                {
                  "context": "tgt",
                  "transform": "create",
                  "parameter": [
                    {
                      "valueString": "Observation"
                    }
                  ]
                }
              ],
              "rule": [
                {
                  "name": "setObservationId",
                  "source": [
                    {
                      "context": "src",
                      "element": "authored",
                      "variable": "authored"
                    }
                  ],
                  "target": [
                    {
                      "context": "tgt",
                      "element": "observation_id",
                      "transform": "copy",
                      "parameter": [
                        {
                          "valueInteger": 0
                        }
                      ]
                    }
                  ]
                },
                {
                  "name": "setPersonId",
                  "source": [
                    {
                      "context": "src",
                      "element": "subject",
                      "variable": "patRef"
                    }
                  ],
                  "target": [
                    {
                      "context": "tgt",
                      "element": "person_id",
                      "transform": "copy",
                      "parameter": [
                        {
                          "valueId": "patRef"
                        }
                      ]
                    }
                  ]
