                    {
                      "context": "tgt",
                      "element": "observation_datetime",
                      "transform": "copy",
                      "parameter": [
                        {
                          "valueId": "dt"
                        }
                      ]
                    }
                  ]
                },
                {
                  "name": "setDate",
                  "source": [
                    {
                      "context": "src",
                      "element": "authored",
                      "variable": "d"
                    }
                  ],
                  "target": [
                    {
                      "context": "tgt",
                      "element": "observation_date",
                      "transform": "copy",
                      "parameter": [
                        {
                          "valueId": "d"
                        }
                      ]
                    }
                  ]
                },
                {
                  "name": "setSourceValue",
                  "source": [
                    {
                      "context": "qitem",
                      "element": "linkId",
                      "variable": "lid"
                    }
                  ],
                  "target": [
                    {
                      "context": "tgt",
                      "element": "observation_source_value",
                      "transform": "evaluate",
                      "parameter": [
                        {
                          "valueId": "src"
                        },
                        {
                          "valueString": "id & '::mobility'"
                        }
                      ]
                    }
                  ],
                  "documentation": "qrId (src.id) concatenated with this rule's own known linkId ('mobility') - evaluated against 'src' (a single context, matching what this StructureMap library's evaluate transform actually supports) rather than trying to reference two different bound variables (qrId from an ancestor rule, linkId from this one) in one expression, which this library does not resolve correctly."
                },
                {
                  "name": "setValueSourceValue",
                  "documentation": "Raw answer code resolved to value_as_concept_id downstream via the EQ-5D-5L Questionnaire's answerOption entries.",
